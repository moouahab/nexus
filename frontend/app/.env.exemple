# Copy this file to `.env` and replace the placeholders with real Google OAuth
# client IDs from Google Cloud Console.
#
# A Google OAuth JSON with an `installed` root is a desktop client. Keep it out
# of Git, and do not use it as GOOGLE_OAUTH_SERVER_CLIENT_ID for the backend
# exchange. Create a Web application OAuth client for the server values below.
GOOGLE_OAUTH_WEB_CLIENT_ID=<web-client-id>
GOOGLE_OAUTH_ANDROID_CLIENT_ID=<android-client-id>
GOOGLE_OAUTH_IOS_CLIENT_ID=<ios-client-id>
GOOGLE_OAUTH_MACOS_CLIENT_ID=<macos-client-id>
GOOGLE_OAUTH_SERVER_CLIENT_ID=<web-client-id>
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000
