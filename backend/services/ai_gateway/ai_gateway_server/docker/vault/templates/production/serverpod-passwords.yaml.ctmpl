{{- with secret "secret/data/nexus/ai_gateway" -}}
shared: {}

production:
  database: '{{ .Data.data.postgres_password }}'
  redis: '{{ .Data.data.redis_password }}'
  serviceSecret: '{{ .Data.data.service_secret }}'
  identityAccessTokenPublicKeyPem: '{{ .Data.data.identity_access_token_public_key_pem }}'
  identityServiceClientId: '{{ .Data.data.identity_service_client_id }}'
  identityServiceClientSecret: '{{ .Data.data.identity_service_client_secret }}'
{{- end -}}
