{{- with secret "secret/data/nexus/projects/production" -}}
shared: {}

production:
  database: '{{ .Data.data.postgres_password }}'
  redis: '{{ .Data.data.redis_password }}'
  serviceSecret: '{{ .Data.data.service_secret }}'
  identityAccessTokenPublicKeyPem: '{{ .Data.data.identity_access_token_public_key_pem }}'
{{- end -}}
