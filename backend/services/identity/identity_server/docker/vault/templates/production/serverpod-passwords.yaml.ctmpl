{{- with secret "secret/data/nexus/identity/production" -}}
shared: {}

production:
  database: '{{ .Data.data.postgres_password }}'
  redis: '{{ .Data.data.redis_password }}'
  serviceSecret: '{{ .Data.data.service_secret }}'
  emailSecretHashPepper: '{{ .Data.data.email_secret_hash_pepper }}'
  jwtHmacSha512PrivateKey: '{{ .Data.data.jwt_hmac_sha512_private_key }}'
  jwtRefreshTokenHashPepper: '{{ .Data.data.jwt_refresh_token_hash_pepper }}'
  authAllowedOrigins: '{{ or .Data.data.auth_allowed_origins "" }}'
  mailFromAddress: '{{ or .Data.data.mail_from_address "no-reply@nexus.example" }}'
  mailFromName: '{{ or .Data.data.mail_from_name "Nexus" }}'
  mailSupportAddress: '{{ or .Data.data.mail_support_address "support@nexus.example" }}'
  smtpHost: '{{ or .Data.data.smtp_host "" }}'
  smtpPort: '{{ or .Data.data.smtp_port "587" }}'
  smtpUsername: '{{ or .Data.data.smtp_username "" }}'
  smtpPassword: '{{ or .Data.data.smtp_password "" }}'
  googleOAuthEnabled: '{{ or .Data.data.google_oauth_enabled "false" }}'
  googleOAuthClientId: '{{ or .Data.data.google_oauth_client_id "" }}'
  googleOAuthClientSecret: '{{ or .Data.data.google_oauth_client_secret "" }}'
  githubOAuthEnabled: '{{ or .Data.data.github_oauth_enabled "false" }}'
  githubOAuthClientId: '{{ or .Data.data.github_oauth_client_id "" }}'
  githubOAuthClientSecret: '{{ or .Data.data.github_oauth_client_secret "" }}'
  appleOAuthEnabled: '{{ or .Data.data.apple_oauth_enabled "false" }}'
  appleOAuthClientId: '{{ or .Data.data.apple_oauth_client_id "" }}'
  appleOAuthClientSecret: '{{ or .Data.data.apple_oauth_client_secret "" }}'
{{- end -}}
