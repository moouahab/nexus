{
  "index_patterns": ["nexus-logs-*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "nexus-local-7-days"
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": { "type": "date" },
        "service": { "properties": { "name": { "type": "keyword" } } },
        "trace": { "properties": { "id": { "type": "keyword" } } },
        "span": { "properties": { "id": { "type": "keyword" } } },
        "event": {
          "properties": {
            "action": { "type": "keyword" },
            "outcome": { "type": "keyword" },
            "duration_ms": { "type": "long" },
            "original": { "type": "match_only_text" }
          }
        },
        "http": {
          "properties": {
            "request": { "properties": { "id": { "type": "keyword" }, "method": { "type": "keyword" } } },
            "response": { "properties": { "status_code": { "type": "integer" } } }
          }
        },
        "ai": {
          "properties": {
            "queue_wait_ms": { "type": "long" },
            "reasoning_level": { "type": "keyword" }
          }
        },
        "container": { "properties": { "id": { "type": "keyword", "ignore_above": 128 } } },
        "log": { "properties": { "stream": { "type": "keyword" } } },
        "tags": { "type": "keyword" }
      }
    }
  }
}
